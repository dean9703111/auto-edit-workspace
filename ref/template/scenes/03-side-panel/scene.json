{
  "key": "side-panel",
  "no": 3,
  "zh": "半版側邊欄",
  "aliases": ["側邊欄", "半版面板", "左側面板"],
  "family": "panel",
  "when": "口播講一個主題加 3–4 個重點，講者右移、左半版面板推入列出重點",
  "avoid": "只有一兩個重點（用字卡）、需要圖示或比較（用全畫面家族）；不可加章節角標",
  "layout": { "data-layout": "滿版", "data-backdrop": "none", "data-person-shift": "480", "data-vbal-ignore": "" },
  "layoutByProfile": { "yt": { "data-top": "165" } },
  "surface": "side",
  "bindsSrt": true,
  "duration": { "default": 9, "min": 5, "fixed": null },
  "addons": [],
  "slots": {
    "eyebrow": { "label": "眉標", "type": "text", "max": 8 },
    "title": { "label": "標題", "type": "rich", "required": true, "max": 18 },
    "items": {
      "label": "項目", "type": "list", "min": 3, "maxItems": 4, "required": true,
      "item": { "text": { "type": "rich", "max": 12 } }
    }
  },
  "beats": {
    "head": { "label": "眉標標題進場", "default": "0.7" }
  },
  "sfx": {
    "main": { "sound": "swipe", "at": "start" },
    "extra": [ { "sound": "tick", "at": "items[0:]" } ]
  },
  "lists": {
    "items": { "at": "1.3 + {{i}} * 0.6" }
  },
  "rules": [
    {"if": "yt && items.length > 3", "error": "yt 性質（品牌橫幅在場、內容頂 ≥ 165）側邊欄最多 3 條；4 條改全畫面清單或拆段"}
  ],
  "sample": {
    "title": "本集流程",
    "sub": "所以我讓 AI 照我的規則剪",
    "duration": 9,
    "slots": {
      "eyebrow": "本集流程",
      "title": "AI 照規則剪//我只負責**把關**",
      "items": ["先剪乾淨：找出 NG", "再剪好看：字幕與字卡", "封裝成 **Skill** 重跑"]
    },
    "beats": {}
  }
}
