{
  "key": "speaker",
  "no": 14,
  "zh": "講者介紹",
  "aliases": ["講者", "講師", "講者介紹", "自我介紹"],
  "family": "lower-third",
  "when": "講者第一次自我介紹，一集只用一次；name、titles 照 ref/style.md 的「講者」填（預設值是作者本人）",
  "avoid": "ref/style.md 沒寫講者、畫面上已經有其他姓名框，或同一集第二次出現",
  "layout": { "data-layout": "滿版", "data-backdrop": "none", "data-top": "520", "data-vbal-ignore": "" },
  "surface": null,
  "bindsSrt": true,
  "duration": { "default": 7, "min": 4.5, "fixed": null },
  "addons": [],
  "tone": true,
  "slots": {
    "tag":    { "label": "標籤", "type": "text", "default": "講師", "max": 4 },
    "name":   { "label": "姓名", "type": "text", "default": "林鼎淵", "max": 5 },
    "titles": { "label": "頭銜", "type": "list", "min": 1, "maxItems": 3, "default": ["外商工程師", "暢銷書作家", "企業內訓講師"], "note": "不填＝預設三個頭銜", "item": { "text": { "label": "頭銜", "type": "text", "required": true, "max": 6 } } }
  },
  "beats": {
    "in": { "label": "進場", "default": "0" }
  },
  "sfx": {
    "main": { "sound": "pop", "at": "in + 0.1" },
    "extra": []
  },
  "lists": {
    "titles": { "at": "{{in}} + 0.6 + {{i}} * 0.1" }
  },
  "rules": [],
  "sample": {
    "title": "講者介紹",
    "sub": "我是鼎淵，歡迎來到工程師下班有約",
    "duration": 7,
    "slots": {
      "titles": ["外商工程師", "暢銷書作家", "企業內訓講師"]
    },
    "beats": {}
  }
}
