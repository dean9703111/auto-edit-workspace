    "slots": {
      "title": "從原始講解到完成影片",
      "nodes": ["轉逐字稿 ｜icon=file-text", "列剪輯清單 ｜icon=list-checks", "初剪 ｜icon=scissors", "包裝影片 ｜icon=clapperboard"],
      "current": "2"
    },
    "beats": {}
  }
