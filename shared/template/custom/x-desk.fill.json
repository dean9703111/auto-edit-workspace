{
  "template": "x-desk",
  "prefix": "xdsk",
  "beat": "A",
  "layout": "fullscreen",
  "when": "一個東西在手機、雲端、電腦三台裝置之間接力（手機拍完自動上傳到雲端，回家在電腦上直接剪）：三個裝置站在 2.5D 地台上，檔案沿地上的虛線一站一站走過去，鏡頭跟著那一站。插圖固定是手機、雲端、電腦，站名只能改字；換別的裝置要改 src 手寫",
  "slots": {
    "title": {
      "label": "標題",
      "type": "text",
      "max": 10,
      "required": true
    },
    "items": {
      "label": "站",
      "type": "list",
      "min": 3,
      "maxItems": 3,
      "required": true,
      "item": {
        "text": {
          "label": "站名（地台正面）",
          "type": "text",
          "max": 3,
          "required": true
        },
        "at": {
          "label": "講到這一站的時間（鏡頭帶過去）",
          "type": "at",
          "ref": "T{n}",
          "required": true
        }
      }
    }
  },
  "sample": {
    "title": "拍完到剪輯",
    "items": [
      {
        "text": "手機",
        "at": "#362@手機"
      },
      {
        "text": "雲端",
        "at": "#363@雲端"
      },
      {
        "text": "電腦",
        "at": "#364@電腦"
      }
    ]
  },
  "sheet": [
    {
      "beat": "0",
      "at": "段起點",
      "show": "主卡＋標題「{title}」",
      "moves": "開場（依前段）；＋0.5 逐字上浮（標題）",
      "focus": "標題"
    },
    {
      "beat": "1",
      "at": "段起點＋1.0",
      "show": "地台",
      "moves": "描線（地台）",
      "focus": "地台"
    },
    {
      "beat": "2",
      "at": "段起點＋1.6",
      "show": "三個裝置（手機、雲端、電腦）＋地台正面的站名",
      "moves": "描線（裝置）；錯拍彈出（站名）",
      "focus": "均衡"
    },
    {
      "beat": "3",
      "at": "段起點＋2.2",
      "show": "地上的虛線路、影子",
      "moves": "描線（虛線路）；淡入（影子）",
      "focus": "方向"
    },
    {
      "each": "items",
      "to": 1,
      "beat": 4,
      "at": "`{at}`",
      "show": "鏡頭帶到站 {n}「{text}」；手機螢幕打勾；檔案從腳邊冒出來",
      "moves": "鏡頭跟焦點（站 {n}）；＋0.2 淡入（螢幕打勾）；＋0.4 彈出（檔案）",
      "focus": "站 {n}"
    },
    {
      "each": "items",
      "from": 2,
      "to": 2,
      "beat": 5,
      "at": "`{at}`",
      "show": "鏡頭帶到站 {n}「{text}」；檔案沿虛線走到雲端（＋1.2 到站）；上傳箭頭亮起",
      "moves": "鏡頭跟焦點（站 {n}）；＋1.2 淡入（上傳箭頭）；＋1.2 漣漪（站名）",
      "focus": "站 {n}"
    },
    {
      "each": "items",
      "from": 3,
      "beat": 6,
      "at": "`{at}`",
      "show": "鏡頭帶到站 {n}「{text}」；檔案沿虛線走到電腦（＋1.2 到站）；螢幕出現播放鍵",
      "moves": "鏡頭跟焦點（站 {n}）；＋1.2 淡入（播放鍵）；＋1.2 漣漪（站名）",
      "focus": "站 {n}",
      "sfx": "success"
    },
    {
      "beat": "收",
      "at": "`{last.at}`＋2.6",
      "show": "三個裝置＋站名＋檔案（停在電腦）",
      "moves": "鏡頭回正",
      "focus": "整體"
    }
  ]
}
