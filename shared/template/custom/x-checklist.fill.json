{
  "template": "x-checklist",
  "prefix": "xchk",
  "beat": "D",
  "layout": "fullscreen",
  "when": "一組要確認、要完成的事（2–4 項，一項一句或一個詞，例「新增專案、下載 APP、配對手機、調整解析度」）；畫面先只有空框，講到哪項那一項寫出來、打勾，進度條跟著走",
  "slots": {
    "title": {
      "label": "標題",
      "type": "text",
      "max": 10,
      "required": true
    },
    "items": {
      "label": "項目",
      "type": "list",
      "min": 2,
      "maxItems": 4,
      "required": true,
      "item": {
        "text": {
          "label": "項目文字（動詞放前面）",
          "type": "text",
          "max": 14,
          "required": true
        },
        "at": {
          "label": "講到項目詞的時間",
          "type": "at",
          "ref": "T{n}",
          "required": true
        }
      }
    },
    "all": {
      "label": "講到「全部好了」那一句的時間（選填；沒有就最後一項講完 2.5 秒收）",
      "type": "at",
      "ref": "ALL"
    }
  },
  "sample": {
    "title": "操作前的準備",
    "items": [
      {
        "text": "新增專案",
        "at": "#121@新增專案"
      },
      {
        "text": "下載 APP",
        "at": "#122@下載"
      },
      {
        "text": "配對手機",
        "at": "#123@配對手機"
      },
      {
        "text": "調整解析度",
        "at": "#124@調整解析度"
      }
    ],
    "all": "#125"
  },
  "sampleMin": {
    "title": "操作前的準備",
    "items": [
      {
        "text": "配對手機",
        "at": "#123@配對手機"
      },
      {
        "text": "調整解析度",
        "at": "#124@調整解析度"
      }
    ]
  },
  "sheet": [
    {
      "beat": "0",
      "at": "段起點",
      "show": "主卡＋標題「{title}」",
      "moves": "開場（依前段）；＋0.5 逐字上浮（標題）",
      "focus": "標題"
    },
    {
      "beat": "1",
      "at": "段起點＋1.0",
      "show": "{n} 個空框（字還不出來）＋進度區（0 / {n}）",
      "moves": "描線（空框，每 0.15 秒一個）；淡入（進度區）",
      "focus": "均衡"
    },
    {
      "each": "items",
      "to": 1,
      "beat": 2,
      "at": "`{at}`",
      "show": "第 {n} 項「{text}」：字浮出，框變主色、打勾，計數＋1",
      "moves": "聚焦（第 {n} 列）；逐字上浮（項目字）；淡入（淡色底）；＋0.3 描線（框與勾）；＋0.3 數字滾動（計數）；＋0.3 進度推進",
      "focus": "第 {n} 項"
    },
    {
      "each": "items",
      "from": 2,
      "beat": 3,
      "at": "`{at}`",
      "show": "第 {n} 項「{text}」：字浮出，框變主色、打勾，計數＋1",
      "moves": "聚焦（第 {n} 列）；逐字上浮（項目字）；淡入（淡色底）；淡出（上一列淡色底）；＋0.3 描線（框與勾）；＋0.3 數字滾動（計數）；＋0.3 進度推進",
      "focus": "第 {n} 項"
    },
    {
      "if": "all",
      "beat": "收",
      "at": "`{all}`",
      "show": "全部列亮回、淡色底收掉；進度條換成完成色",
      "moves": "回均衡；淡出（淡色底）；淡入（完成色）",
      "focus": "整體",
      "sfx": "success"
    },
    {
      "if": "!all",
      "beat": "收",
      "at": "`{last.at}`＋2.5",
      "show": "全部列亮回、淡色底收掉；進度條換成完成色",
      "moves": "回均衡；淡出（淡色底）；淡入（完成色）",
      "focus": "整體",
      "sfx": "success"
    }
  ]
}
