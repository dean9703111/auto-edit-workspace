{
  "template": "x-news",
  "prefix": "xnews",
  "beat": "E",
  "layout": "fullscreen",
  "when": "轉述一則新聞、公告、官方數據：有一個大數字和一段變化（YouTube 說 Shorts 觀看次數是去年的兩倍，這半年一路往上，官方部落格公布）。沒有主卡，快訊標籤＋標題條，大數字卡、走勢卡翻起來，最後亮出來源",
  "slots": {
    "tag": {
      "label": "快訊標籤",
      "type": "text",
      "max": 2,
      "required": true
    },
    "tagIcon": {
      "label": "快訊標籤圖示（選填，預設 newspaper）",
      "type": "icon"
    },
    "headline": {
      "label": "標題條",
      "type": "text",
      "max": 14,
      "required": true
    },
    "bigLabel": {
      "label": "大數字卡的說明（數字上面）",
      "type": "text",
      "max": 8,
      "required": true
    },
    "bigNum": {
      "label": "大數字（從 0 數上去；有小數要同時寫 bigDec）",
      "type": "number",
      "required": true
    },
    "bigDec": {
      "label": "大數字的小數位數（選填：整數不用寫；1.5 倍寫 1）",
      "type": "enum",
      "options": [0, 1, 2]
    },
    "unit": {
      "label": "大數字的單位",
      "type": "text",
      "max": 2,
      "required": true
    },
    "bigSub": {
      "label": "大數字卡的下面那行",
      "type": "text",
      "max": 6,
      "required": true
    },
    "trendPts": {
      "label": "走勢折線的 6 個點（選填：不寫就沒有走勢卡，大數字卡改寬；要寫就連 trendLabel、trendValue、trendIcon、trendAt 一起寫）。y 是高度：24 最高、216 貼底，往右上是漲、往右下是跌；終點圓放在最後一點",
      "type": "list",
      "min": 6,
      "maxItems": 6,
      "item": {
        "y": {
          "label": "高度 y（24–216，越小越高）",
          "type": "number",
          "required": true
        }
      }
    },
    "trendLabel": {
      "label": "走勢卡的標題（有 trendPts 才要）",
      "type": "text",
      "max": 6
    },
    "trendValue": {
      "label": "漲幅（有 trendPts 才要）",
      "type": "text",
      "max": 5
    },
    "trendIcon": {
      "label": "走勢卡圖示（有 trendPts 才要；漲 trending-up、跌 trending-down）",
      "type": "icon"
    },
    "source": {
      "label": "來源列（選填：不寫就沒有出處那一拍，要寫就連 srcAt 一起寫）",
      "type": "text",
      "max": 24
    },
    "bigAt": {
      "label": "講到大數字的時間（大數字卡翻起來、數字數上去）",
      "type": "at",
      "ref": "T1",
      "required": true
    },
    "trendAt": {
      "label": "講到變化的時間（走勢卡翻起來、折線畫上去；有 trendPts 才要）",
      "type": "at",
      "ref": "T2"
    },
    "srcAt": {
      "label": "講到出處的時間（來源列擦開；有 source 才要）",
      "type": "at",
      "ref": "T3"
    }
  },
  "sample": {
    "tag": "快訊",
    "headline": "YouTube 公布 Shorts 數據",
    "bigLabel": "Shorts 觀看次數",
    "bigNum": 2,
    "unit": "倍",
    "bigSub": "比去年同期",
    "trendPts": [
      { "y": 196 },
      { "y": 170 },
      { "y": 176 },
      { "y": 120 },
      { "y": 96 },
      { "y": 24 }
    ],
    "trendLabel": "近 6 個月",
    "trendValue": "+120%",
    "trendIcon": "trending-up",
    "source": "資料來源：YouTube 官方部落格（2026 年 10 月）",
    "bigAt": "#372@兩倍",
    "trendAt": "#373@半年",
    "srcAt": "#374@官方"
  },
  "sampleMin": {
    "tag": "快訊",
    "headline": "YouTube 公布 Shorts 數據",
    "bigLabel": "Shorts 觀看次數",
    "bigNum": 2,
    "unit": "倍",
    "bigSub": "比去年同期",
    "bigAt": "#372@兩倍"
  },
  "sheet": [
    {
      "beat": "0",
      "at": "段起點",
      "show": "快訊標籤「{tag}」翻起來；標題條「{headline}」由左擦開",
      "moves": "＋0.65 圖示描線（快訊標籤）；＋0.7 擦開（標題條，由左）；＋0.9 逐字上浮（標題）",
      "focus": "標題"
    },
    {
      "beat": "1",
      "at": "`{bigAt}`",
      "show": "大數字卡從平躺翻起來：說明「{bigLabel}」＋大數字「{bigNum}{unit}」＋「{bigSub}」",
      "moves": "＋0.2 數字滾動（大數字 0 → {bigNum}）",
      "focus": "大數字",
      "sfx": "impact"
    },
    {
      "if": "trendPts",
      "beat": "2",
      "at": "`{trendAt}`",
      "show": "走勢卡翻起來：圖示＋「{trendLabel}」＋折線＋終點圓＋漲幅「{trendValue}」",
      "moves": "＋0.15 圖示描線（走勢圖示）；＋0.4 描線（折線）；＋0.4 淡入（面）；＋1.4 彈出（終點圓、漲幅）",
      "focus": "走勢卡"
    },
    {
      "if": "source",
      "beat": "3",
      "at": "`{srcAt}`",
      "show": "來源列「{source}」",
      "moves": "擦開（來源列，由左）",
      "focus": "來源列"
    }
  ]
}
