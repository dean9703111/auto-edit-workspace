{
  "template": "x-architecture-send",
  "prefix": "xars",
  "beat": "A",
  "layout": "fullscreen",
  "when": "把一樣東西傳給 2–3 個人或地方（把連結傳給客戶、主管和字幕師）：講到誰，紙飛機就從寄件端飛向誰、到站打勾；講到「都收到」時全部亮回、結論膠囊彈出（all、done 一起填；沒有這一句就不填）",
  "slots": {
    "title": {
      "label": "標題",
      "type": "text",
      "max": 10,
      "required": true
    },
    "me": {
      "label": "寄件端",
      "type": "text",
      "max": 4,
      "required": true
    },
    "meIcon": {
      "label": "寄件端圖示",
      "type": "icon",
      "required": true
    },
    "items": {
      "label": "收件人",
      "type": "list",
      "min": 2,
      "maxItems": 3,
      "required": true,
      "item": {
        "text": {
          "label": "收件人名稱",
          "type": "text",
          "max": 4,
          "required": true
        },
        "icon": {
          "label": "收件人圖示",
          "type": "icon",
          "required": true
        },
        "at": {
          "label": "講到這個收件人的時間（紙飛機起飛）",
          "type": "at",
          "ref": "S{n}",
          "required": true
        }
      }
    },
    "all": {
      "label": "講到「都收到」的時間（全部亮回、結論膠囊彈出）。沒有這一句就不填 all、done",
      "type": "at",
      "ref": "ALL"
    },
    "done": {
      "label": "結論膠囊",
      "type": "text",
      "max": 6
    }
  },
  "sample": {
    "title": "完成影片連結傳出去",
    "me": "完成影片",
    "meIcon": "film",
    "items": [
      {
        "text": "客戶",
        "icon": "user",
        "at": "#302@客戶"
      },
      {
        "text": "主管",
        "icon": "user",
        "at": "#303@主管"
      },
      {
        "text": "字幕師",
        "icon": "user",
        "at": "#304@字幕師"
      }
    ],
    "all": "#305@都收到",
    "done": "都收到"
  },
  "sheet": [
    {
      "beat": "0",
      "at": "段起點",
      "show": "主卡＋標題「{title}」",
      "moves": "開場（依前段）；＋0.5 逐字上浮（標題）",
      "focus": "標題"
    },
    {
      "beat": "1",
      "at": "段起點＋0.7",
      "show": "寄件端「{me}」＋圖示；全部的收件人＋圖示",
      "moves": "彈出（寄件端）；＋0.15 圖示描線（寄件端）；＋0.3 錯拍彈出（收件人）；＋0.15 圖示描線（錯拍）",
      "focus": "均衡"
    },
    {
      "beat": "2",
      "at": "段起點＋1.7",
      "show": "—",
      "moves": "預覽態（收件人）",
      "focus": "整體"
    },
    {
      "each": "items",
      "to": 1,
      "beat": 3,
      "at": "`{at}`",
      "show": "紙飛機從寄件端飛向收件人 {n}「{text}」；到站（＋1.0）那一列亮起、勾勾彈出",
      "moves": "漣漪（寄件端圖示）；＋1.0 聚焦（收件人 {n}）；＋1.0 彈出（勾勾）；＋0.1 圖示描線（勾勾）",
      "focus": "收件人 {n}"
    },
    {
      "each": "items",
      "from": 2,
      "beat": 4,
      "at": "`{at}`",
      "show": "紙飛機從寄件端飛向收件人 {n}「{text}」；到站（＋1.0）那一列亮起、勾勾彈出",
      "moves": "漣漪（寄件端圖示）；＋1.0 聚焦（收件人 {n}）；走過（前面收過的列）；＋1.0 彈出（勾勾）；＋0.1 圖示描線（勾勾）",
      "focus": "收件人 {n}"
    },
    {
      "if": "all",
      "beat": "收",
      "at": "`{all}`",
      "show": "全部收件人亮回；結論膠囊「{done}」",
      "moves": "回均衡；彈出（結論膠囊）",
      "focus": "結論",
      "sfx": "success"
    }
  ]
}
