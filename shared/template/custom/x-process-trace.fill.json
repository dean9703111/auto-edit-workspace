{
  "template": "x-process-trace",
  "prefix": "xprt",
  "beat": "A",
  "layout": "fullscreen",
  "when": "訊號、資料、聲音一路經過 3–4 個裝置或步驟（聲音從麥克風進錄音介面、再進電腦、最後到剪輯軟體）：畫成電路板，講到一站，訊號沿走線跑過去、那顆晶片亮燈，最後一道光跑完全程",
  "slots": {
    "title": {
      "label": "標題",
      "type": "text",
      "max": 10,
      "required": true
    },
    "items": {
      "label": "站",
      "type": "list",
      "min": 3,
      "maxItems": 4,
      "required": true,
      "item": {
        "text": {
          "label": "站名",
          "type": "text",
          "max": 4,
          "required": true
        },
        "icon": {
          "label": "站圖示",
          "type": "icon",
          "required": true
        },
        "at": {
          "label": "講到站名的時間",
          "type": "at",
          "ref": "T{n}",
          "required": true
        }
      }
    }
  },
  "sample": {
    "title": "聲音怎麼進剪輯",
    "items": [
      {
        "text": "麥克風",
        "icon": "mic",
        "at": "#212@麥克風"
      },
      {
        "text": "錄音介面",
        "icon": "audio-lines",
        "at": "#213@錄音介面"
      },
      {
        "text": "電腦",
        "icon": "laptop",
        "at": "#214@電腦"
      },
      {
        "text": "剪輯軟體",
        "icon": "scissors",
        "at": "#215@剪輯軟體"
      }
    ]
  },
  "sheet": [
    {
      "beat": "0",
      "at": "段起點",
      "show": "主卡＋標題「{title}」",
      "moves": "開場（依前段）；＋0.5 逐字上浮（標題）",
      "focus": "標題"
    },
    {
      "beat": "1",
      "at": "段起點＋0.7",
      "show": "全部的晶片＋圖示",
      "moves": "錯拍彈出（晶片）；＋0.15 圖示描線（錯拍）",
      "focus": "均衡"
    },
    {
      "beat": "2",
      "at": "段起點＋1.2",
      "show": "晶片間還沒通電的虛線走線、焊點",
      "moves": "淡入（虛線、焊點）",
      "focus": "方向"
    },
    {
      "beat": "3",
      "at": "段起點＋1.7",
      "show": "—",
      "moves": "預覽態（晶片）；鏡頭慢推",
      "focus": "整體"
    },
    {
      "each": "items",
      "to": 1,
      "beat": 4,
      "at": "`{at}`",
      "show": "晶片 {n}「{text}」變主色、指示燈亮",
      "moves": "鏡頭跟焦點（−0.2）；聚焦（晶片 {n}）；淡入（主色、指示燈）；漣漪（晶片 {n} 圖示）",
      "focus": "晶片 {n}"
    },
    {
      "each": "items",
      "from": 2,
      "beat": 5,
      "at": "`{at}`",
      "show": "訊號帶發光頭沿走線跑到晶片 {n}「{text}」；晶片 {n} 變主色、指示燈亮",
      "moves": "彗星描線（走線，−0.85）；鏡頭跟焦點（−0.2）；聚焦（晶片 {n}）；走過（前一站）；淡出（前一站的主色）；淡入（主色、指示燈）；漣漪（晶片 {n} 圖示）",
      "focus": "晶片 {n}"
    },
    {
      "beat": "收",
      "at": "`{last.at}`＋2.6",
      "show": "全部晶片＋走線；一道光從第一站跑完全程",
      "moves": "回均衡；淡出（最後一站的主色）；鏡頭回正；彗星描線（光沿全部走線跑到最後一站，每段 0.3 秒接力）",
      "focus": "整體"
    }
  ]
}
