{
  "template": "x-checklist-ai",
  "prefix": "xcai",
  "beat": "D",
  "layout": "fullscreen",
  "when": "交給 AI（或工具）一條一條跑完的工作（2–4 項，每項有一個結果，例「讀完逐字稿 3,214 字、找出重講 12 處」）；每列先轉圈，講到哪項那一列打勾、右邊跳出結果，下一列接著轉",
  "slots": {
    "title": {
      "label": "標題",
      "type": "text",
      "max": 10,
      "required": true
    },
    "items": {
      "label": "工作項目",
      "type": "list",
      "min": 2,
      "maxItems": 4,
      "required": true,
      "item": {
        "text": {
          "label": "項目文字（動詞放前面，從一開始就看得到）",
          "type": "text",
          "max": 10,
          "required": true
        },
        "res": {
          "label": "結果",
          "type": "text",
          "max": 6,
          "required": true
        },
        "at": {
          "label": "講到項目詞（做完這項）的時間",
          "type": "at",
          "ref": "T{n}",
          "required": true
        }
      }
    },
    "all": {
      "label": "講到「全部好了」那一句的時間（選填；沒有就最後一項講完 2.5 秒收）",
      "type": "at",
      "ref": "ALL"
    }
  },
  "sample": {
    "title": "AI 幫我剪片",
    "items": [
      {
        "text": "讀完逐字稿",
        "res": "3,214 字",
        "at": "#252@逐字稿"
      },
      {
        "text": "找出重講",
        "res": "12 處",
        "at": "#253@重講"
      },
      {
        "text": "列剪輯清單",
        "res": "24 刀",
        "at": "#254@剪輯清單"
      },
      {
        "text": "產生字幕",
        "res": "186 則",
        "at": "#255@字幕"
      }
    ],
    "all": "#256"
  },
  "sampleMin": {
    "title": "AI 幫我剪片",
    "items": [
      {
        "text": "列剪輯清單",
        "res": "24 刀",
        "at": "#254@剪輯清單"
      },
      {
        "text": "產生字幕",
        "res": "186 則",
        "at": "#255@字幕"
      }
    ]
  },
  "sheet": [
    {
      "beat": "0",
      "at": "段起點",
      "show": "主卡＋標題「{title}」",
      "moves": "開場（依前段）；＋0.5 逐字上浮（標題）",
      "focus": "標題"
    },
    {
      "beat": "1",
      "at": "段起點＋1.0",
      "show": "{n} 列待辦（項目字＋灰色虛線等待圈，結果還沒出來）＋進度區（0 / {n}）；第 1 列從 1.6 秒開始轉圈，每做完一項下一列接著轉",
      "moves": "錯拍彈出（列）；淡入（進度區）",
      "focus": "均衡"
    },
    {
      "each": "items",
      "to": 1,
      "beat": 2,
      "at": "`{at}`",
      "show": "第 {n} 項「{text}」：轉圈換成打勾，結果「{res}」逐字跳出，計數＋1",
      "moves": "淡出（轉圈與等待圈）；描線（圈與勾）；＋0.15 逐字上浮（結果）；＋0.3 數字滾動（計數）；＋0.3 進度推進；聚焦（第 {n} 列）；淡入（淡色底）",
      "focus": "第 {n} 項"
    },
    {
      "each": "items",
      "from": 2,
      "beat": 3,
      "at": "`{at}`",
      "show": "第 {n} 項「{text}」：轉圈換成打勾，結果「{res}」逐字跳出，計數＋1",
      "moves": "淡出（轉圈與等待圈）；描線（圈與勾）；＋0.15 逐字上浮（結果）；＋0.3 數字滾動（計數）；＋0.3 進度推進；聚焦（第 {n} 列）；淡入（淡色底）；淡出（上一列淡色底）",
      "focus": "第 {n} 項"
    },
    {
      "if": "all",
      "beat": "收",
      "at": "`{all}`",
      "show": "全部列亮回、淡色底收掉；進度條換成完成色",
      "moves": "回均衡；淡出（淡色底）；淡入（完成色）",
      "focus": "整體",
      "sfx": "success"
    },
    {
      "if": "!all",
      "beat": "收",
      "at": "`{last.at}`＋2.5",
      "show": "全部列亮回、淡色底收掉；進度條換成完成色",
      "moves": "回均衡；淡出（淡色底）；淡入（完成色）",
      "focus": "整體",
      "sfx": "success"
    }
  ]
}
