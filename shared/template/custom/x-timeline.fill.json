{
  "template": "x-timeline",
  "prefix": "xtl",
  "beat": "B",
  "layout": "fullscreen",
  "when": "有時間先後的 3–4 個點（年份、版本、階段，或「這集分成三個部分」的本集大綱）：捷運路線圖，講到哪一點，目前位置沿路線滑過去、站名牌彈起、下方一行說明",
  "slots": {
    "title": {
      "label": "標題",
      "type": "text",
      "max": 10,
      "required": true
    },
    "items": {
      "label": "時間點",
      "type": "list",
      "min": 3,
      "maxItems": 4,
      "required": true,
      "item": {
        "text": {
          "label": "站名牌上的字（4 位數字的年份，或 ≤ 2 個字；本集大綱寫 01／02／03）",
          "type": "text",
          "max": 2,
          "required": true
        },
        "desc": {
          "label": "說明",
          "type": "text",
          "max": 4,
          "required": true
        },
        "desc2": {
          "label": "說明第 2 行（選填）",
          "type": "text",
          "max": 4
        },
        "icon": {
          "label": "圖示",
          "type": "icon",
          "required": true
        },
        "at": {
          "label": "講到這個時間點的時間",
          "type": "at",
          "ref": "T{n}",
          "required": true
        }
      }
    }
  },
  "sample": {
    "title": "我的拍片歷程",
    "items": [
      {
        "text": "2019",
        "desc": "開始拍片",
        "icon": "clapperboard",
        "at": "#131@2019"
      },
      {
        "text": "2022",
        "desc": "改用手機",
        "icon": "smartphone",
        "at": "#132@2022"
      },
      {
        "text": "2024",
        "desc": "多機錄影",
        "icon": "video",
        "at": "#133@2024"
      },
      {
        "text": "今年",
        "desc": "交給 AI",
        "icon": "bot",
        "at": "#134@今年"
      }
    ]
  },
  "sampleMin": {
    "title": "我的拍片歷程",
    "items": [
      {
        "text": "2019",
        "desc": "開始拍片",
        "icon": "clapperboard",
        "at": "#131@2019"
      },
      {
        "text": "2022",
        "desc": "改用",
        "desc2": "手機拍",
        "icon": "smartphone",
        "at": "#132@2022"
      },
      {
        "text": "2024",
        "desc": "多機錄影",
        "icon": "video",
        "at": "#133@2024"
      }
    ]
  },
  "sheet": [
    {
      "beat": "0",
      "at": "段起點",
      "show": "主卡＋標題「{title}」",
      "moves": "開場（依前段）；＋0.5 逐字上浮（標題）",
      "focus": "標題"
    },
    {
      "beat": "1",
      "at": "段起點＋1.2",
      "show": "橫軸＋{n} 個空心站點",
      "moves": "彗星描線（橫軸）；＋0.15 描線（空心站點，錯拍）",
      "focus": "橫軸"
    },
    {
      "beat": "2",
      "at": "點 1 −1.1",
      "show": "進度頭（目前位置）在路線左端",
      "moves": "彈出（進度頭）",
      "focus": "進度頭"
    },
    {
      "each": "items",
      "from": 1,
      "to": 1,
      "if": "items.1.desc2",
      "beat": 3,
      "at": "`{at}`",
      "show": "站名牌「{text}」＋圖示＋說明「{desc}／{desc2}」",
      "moves": "進度推進（−0.5）；漣漪（進度頭）；描線（站點圈）；彈出（站名牌）；＋0.14 逐字上浮（說明）；＋0.18 圖示描線；＋0.6 聚焦（站名牌）",
      "focus": "點 {n}"
    },
    {
      "each": "items",
      "from": 1,
