{
  "template": "x-ring-facets",
  "prefix": "xrf",
  "beat": "D",
  "layout": "fullscreen",
  "when": "一件事由 3–4 個面向組成、缺一不可：圓環分段加右邊編號清單，講到哪個面向亮哪一段（可選每個面向的說明、總結句；例：好影片要顧內容、剪輯、聲音和畫面）",
  "slots": {
    "title": {
      "label": "標題",
      "type": "text",
      "max": 10,
      "required": true
    },
    "topic": {
      "label": "環中間的主題（單行，≤ 4 字）",
      "type": "text",
      "max": 4,
      "required": true
    },
    "topic2": {
      "label": "環中間主題的第二行（選填，≤ 4 字；主題要兩行時才寫，topic 就是第一行）",
      "type": "text",
      "max": 4
    },
    "items": {
      "label": "面向（順序＝環上從 12 點鐘順時針）",
      "type": "list",
      "min": 3,
      "maxItems": 4,
      "required": true,
      "item": {
        "text": {
          "label": "面向名（和說明合計要放得進列寬：名稱字數×52＋說明字數×40 ≤ 344）",
          "type": "text",
          "max": 5,
          "required": true
        },
        "desc": {
          "label": "說明（選填，≤ 6 字；名稱 2 字配 ≤ 6 字、3 字配 ≤ 4 字、4 字配 ≤ 3 字、5 字配 ≤ 2 字）",
          "type": "text",
          "max": 6
        },
        "at": {
          "label": "講到這個面向的時間（相鄰兩個至少差 2.5 秒）",
          "type": "at",
          "ref": "T{n}",
          "required": true
        }
      }
    },
    "allAt": {
      "label": "講到總結那一句的時間（選填；沒有就在最後一個面向後 2 秒回均衡）",
      "type": "at",
      "ref": "ALL"
    }
  },
  "sample": {
    "title": "好影片的四個面向",
    "topic": "好影片",
    "items": [
      {
        "text": "內容",
        "desc": "值得看完",
        "at": "#272@內容"
      },
      {
        "text": "剪輯",
        "desc": "節奏不拖",
        "at": "#273@剪輯"
      },
      {
        "text": "聲音",
        "desc": "清楚不吵",
        "at": "#274@聲音"
      },
      {
        "text": "畫面",
        "desc": "穩定明亮",
        "at": "#275@畫面"
      }
    ],
    "allAt": "#276"
  },
  "sampleMin": {
    "title": "好影片的三個面向",
    "topic": "好影片",
    "items": [
      {
        "text": "內容",
        "desc": "值得看完",
        "at": "#272@內容"
      },
      {
        "text": "剪輯",
        "at": "#273@剪輯"
      },
      {
        "text": "聲音",
        "desc": "清楚不吵",
        "at": "#274@聲音"
      }
    ]
  },
  "sheet": [
    {
      "beat": "0",
      "at": "段起點",
      "show": "主卡＋標題「{title}」",
      "moves": "開場（依前段）；＋0.5 逐字上浮（標題）",
      "focus": "標題"
    },
    {
      "beat": "1",
      "at": "段起點＋1.0",
      "show": "灰色圓環（{n} 段）＋中間主題「{topic}」",
      "moves": "描線（環段，錯拍）；＋0.5 逐字上浮（主題）",
      "focus": "圓環"
    },
    {
      "each": "items",
      "beat": 2,
      "at": "`{at}`",
      "show": "面向 {n}「{text}」：環上那一段變主色、編號圓、右邊那一列",
      "moves": "描線（環段）；＋0.3 彈出（編號圓）；彈出（列）；＋0.12 逐字上浮（名稱與說明）；＋0.5 聚焦（列 {n}）",
      "focus": "面向 {n}"
    },
    {
      "beat": "收",
      "if": "allAt",
      "at": "`{allAt}`",
      "show": "清單全部亮回；主題漣漪",
      "moves": "回均衡；漣漪（主題）",
      "focus": "整體"
    },
    {
      "beat": "收",
      "if": "!allAt",
      "at": "`{last.at}`＋2.0",
      "show": "清單全部亮回；主題漣漪",
      "moves": "回均衡；漣漪（主題）",
      "focus": "整體"
    }
  ]
}
