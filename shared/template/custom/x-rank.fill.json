{
  "template": "x-rank",
  "prefix": "xrk",
  "beat": "E",
  "layout": "fullscreen",
  "when": "在比誰最多：3–5 個項目各有一個數字、要看出名次（「最花時間的是…再來是…」「最多人問的第一名是…」）；項目照講的順序寫，畫面照數字由大到小排，講到哪一項那一列的長條長出來、數字數上去",
  "slots": {
    "title": {
      "label": "標題（在比什麼）",
      "type": "text",
      "max": 12,
      "required": true
    },
    "icon": {
      "label": "標題列圖示（排名用 trophy，時間用 clock，錢用 coins）",
      "type": "icon",
      "required": true
    },
    "unit": {
      "label": "數字的單位（選填，例「分鐘」「%」）",
      "type": "text",
      "max": 4
    },
    "items": {
      "label": "項目（照講的順序寫；畫面會照數字自動排名）",
      "type": "list",
      "min": 3,
      "maxItems": 5,
      "required": true,
      "item": {
        "text": {
          "label": "項目名稱",
          "type": "text",
          "max": 6,
          "required": true
        },
        "value": {
          "label": "數字（0–99999，可以有小數；單位寫在 unit）",
          "type": "number",
          "min": 0,
          "max": 99999,
          "required": true
        },
        "at": {
          "label": "講到這一項的時間",
          "type": "at",
          "ref": "T{n}",
          "required": true
        }
      }
    },
    "topAt": {
      "label": "講到結論的時間（選填，例「光這一項就佔一半」；要比最後一項晚 2 秒以上）",
      "type": "at",
      "ref": "TOP"
    }
  },
  "sample": {
    "title": "最花時間的步驟",
    "icon": "trophy",
    "unit": "分鐘",
    "items": [
      { "text": "輸出", "value": 20, "at": "#502@輸出" },
      { "text": "配音效", "value": 30, "at": "#503@音效" },
      { "text": "做字卡", "value": 50, "at": "#504@字卡" },
      { "text": "上字幕", "value": 60, "at": "#505@字幕" },
      { "text": "找 NG", "value": 90, "at": "#506@NG" }
    ],
    "topAt": "#507@一半"
  },
  "sampleMin": {
    "title": "最花時間的步驟",
    "icon": "trophy",
    "items": [
      { "text": "輸出", "value": 20, "at": "#502@輸出" },
      { "text": "配音效", "value": 30, "at": "#504@字卡" },
      { "text": "做字卡", "value": 50, "at": "#506@NG" }
    ]
  },
  "sheet": [
    {
      "beat": "0",
      "at": "段起點",
      "show": "主卡「{title}」＋名次徽章、空軌道",
      "moves": "開場（依前段）；＋0.5 圖示描線；＋0.62 逐字上浮（標題）",
      "focus": "主卡"
    },
    {
      "each": "items",
      "beat": 1,
      "at": "`{at}`",
      "show": "「{text}」{value}（照數字排到它的名次）",
      "moves": "擦開（這一列，由左）；＋0.1 量條；＋0.1 數字滾動（0 → {value}）",
      "focus": "「{text}」"
    },
    {
      "if": "topAt",
      "beat": "結論",
      "at": "`{topAt}`",
      "show": "第一名那一列",
      "moves": "退焦（其他列 → 0.5）；＋0.1 重拍（第一名的數字）；＋0.1 螢光筆（第一名的名稱）",
      "focus": "第一名",
      "sfx": "impact"
    }
  ]
}
